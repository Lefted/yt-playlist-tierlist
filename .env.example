# Copy to `.env` for local development: `cp .env.example .env`.
#
# `vite dev`, `vite build` and the drizzle-kit scripts read `.env`. The built node
# server (`node build`) does NOT — give it a real environment (compose, Kubernetes,
# `VAR=… node build`).

# --- Required -----------------------------------------------------------------

# Postgres. Matches deploy/docker-compose.yml; in the cluster it points at amv-db.
DATABASE_URL=postgres://amv:amv@localhost:5432/amv

# --- Required in production (NODE_ENV=production), optional in development ------

# Server-side YouTube Data API v3 key. The server calls YouTube; users never see it.
# https://console.cloud.google.com/ → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# Public origin, no trailing slash. adapter-node rejects form posts without it.
# Production: https://amv.lefted.dev
ORIGIN=http://localhost:3000

# --- Optional -----------------------------------------------------------------

# First admin account, created on an empty users table (#16). Both or neither.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the node server listens on. The image exposes 3000.
PORT=3000

# Database the `*.db.test.js` integration tests may WIPE. Unset: they skip.
# With deploy/docker-compose.yml up, this is the same database as DATABASE_URL.
TEST_DATABASE_URL=

# --- Injected by the image build, not set by hand -------------------------------

# GIT_SHA=unknown      # git rev-parse --short HEAD at build time
# BUILD_TIME=unknown   # ISO-8601 timestamp of the build
