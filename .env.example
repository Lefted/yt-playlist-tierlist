# Copy to `.env` for local development: `cp .env.example .env`.
#
# `vite dev`, `vite build` and the drizzle-kit scripts read `.env`. The built node
# server (`node build`) does NOT — give it a real environment (compose, Kubernetes,
# `VAR=… node build`).

# --- Required -----------------------------------------------------------------

# Postgres. Matches deploy/docker-compose.yml; in the cluster it points at amv-db.
DATABASE_URL=postgres://amv:amv@localhost:5432/amv

# --- Required in production (NODE_ENV=production), optional in development ------

# `production` turns the two variables below into hard requirements. The node
# server sets nothing by itself; the image and the k8s manifest set this.
NODE_ENV=development

# Server-side YouTube Data API v3 key, for the import proxy #17 adds. Until then
# the browser still uses the key you paste into the import dialog; a deployment is
# required to carry this one so that switch needs no second rollout.
# https://console.cloud.google.com/ → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# Public origin, no trailing slash. adapter-node rejects form posts without it.
# Production: https://amv.lefted.dev
ORIGIN=http://localhost:3000

# --- Optional -----------------------------------------------------------------

# First admin account, created on boot when the users table is empty. Both or
# neither. Ignored once anybody has an account, so they are safe to leave set;
# the password must be at least 10 characters. Everyone else joins by invite.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the node server listens on. The image exposes 3000.
PORT=3000

# Only behind a reverse proxy. Without them adapter-node reports the *proxy's*
# address as the client's, and the login rate limiter's per-IP bucket becomes one
# global bucket (ten failed logins anywhere would lock everyone out for fifteen
# minutes). XFF_DEPTH counts trusted proxies from the right: 1 for a single
# ingress. Set in deploy/k8s/app.yaml; leave both blank for a direct connection.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Database the `*.db.test.js` integration tests may WIPE. Unset: they skip.
# With deploy/docker-compose.yml up, this is the same database as DATABASE_URL.
TEST_DATABASE_URL=

# --- Injected by the image build, not set by hand -------------------------------

# GIT_SHA=unknown      # git rev-parse --short HEAD at build time
# BUILD_TIME=unknown   # ISO-8601 timestamp of the build
