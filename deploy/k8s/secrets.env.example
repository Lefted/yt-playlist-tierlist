# Copy to deploy/k8s/secrets.env and fill in real values. secrets.env is
# gitignored and is the ONLY copy of these credentials — see
# docs/deploy/runbook.md.
#
# Both cluster Secrets are created from this one file:
#   kubectl -n amv create secret generic postgres-credentials --from-env-file=deploy/k8s/secrets.env
#   kubectl -n amv create secret generic amv-env              --from-env-file=deploy/k8s/secrets.env
#
# `--from-env-file` copies EVERY key into EACH Secret. That is intentional: a
# container only sees the Secret named in its own `envFrom` and reads only the
# variables it knows about, and one file means POSTGRES_PASSWORD and
# DATABASE_URL cannot drift apart — the one mistake this setup has to defend
# against.

# --- postgres-credentials (StatefulSet/postgres) ---
# Read by the postgres image's entrypoint, and only on the FIRST boot against
# an empty volume. Changing POSTGRES_PASSWORD here does not change the running
# server's password; see "Rotate the Postgres password" in the runbook.
POSTGRES_DB=amv
POSTGRES_USER=amv
POSTGRES_PASSWORD=

# --- amv-env (Deployment/amv-tierlist) ---
# Must encode the same user / password / database as the three keys above.
#
# Generate the password with `openssl rand -hex 24`. Use that exact form: it is
# alphanumeric by construction, so the raw value and the percent-encoded value
# inside this URL are identical. Any of `@ : / ? # %` in a password has to be
# percent-encoded HERE but not in POSTGRES_PASSWORD above (`p@ss` -> `p%40ss`),
# and getting that wrong means the pods fail to connect with an error that
# points at the host, not at the password.
DATABASE_URL=postgres://amv:<password>@amv-db.amv.svc.cluster.local:5432/amv?sslmode=disable

# Server-side YouTube Data API v3 key. The server calls YouTube; users never
# enter a key. Restrict it to the YouTube Data API v3 in the Google console —
# an IP/referrer restriction does not fit a server-side key.
YOUTUBE_API_KEY=

# Bootstrap admin. Used once, on boot against an empty users table, to create
# the first account; sign-up is invite-only afterwards. Pick a password you do
# not use anywhere else and change it after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
